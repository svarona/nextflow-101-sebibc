process {
    resourceLimits = [
        cpus: 10,
        memory: '6.GB',
        time: '1.h'
    ]

    withName: 'FASTQC' {
        conda = '/home/svarona/miniconda3/envs/fastqc'
    }

    withName: 'MULTIQC' {
        conda = '/home/svarona/miniconda3/envs/multiqc'
    }

    withName: 'FASTP' {
        conda = '/home/svarona/miniconda3/envs/fastp'
    }
}