#!/usr/bin/env nextflow

/*
 * This workflow:
 * 1. Receives a comma-separated list of names.
 * 2. Creates a channel with individual names.
 * 3. Filters out names containing only one character.
 * 4. Transforms each remaining name into a greeting.
 * 5. Executes one SAVE_GREETINGS task per greeting.
 * 6. Publishes the generated files.
 */


/*
 * PROCESS: SAVE_GREETINGS
 *
 * - Receive one greeting.
 * - Write the greeting into a text file.
 * - Return the generated file.
 */

process SAVE_GREETINGS {

    input:
    // Receive one greeting as a value
    val greeting

    output:
    // Declare the file generated by this process
    path "*.txt", emit: result

    script:
    // Extract the name from the greeting
    def name = greeting.replace('Hello ', '').replace('!', '')

    """
    echo '${greeting}' > '${name}.txt'
    """
}

/*
 * PROCESS: COLLECT_GREETINGS
 *
 * - Receive a list containing all greetings.
 * - Write all greetings into a single text file.
 * - Return the generated file.
 */

process COLLECT_GREETINGS {

    input:
    // Receive all greetings as a single list
    val greetings

    output:
    // Declare the file generated by this process
    path 'all_greetings.txt', emit: result

    script:
    // Write all greetings into a single file
    def greetings_text = greetings.join('\n')

    """
    printf '%s\\n' '${greetings_text}' > all_greetings.txt
    """
}


/*
 * WORKFLOW: CREATE_GREETINGS
 *
 * - Receive a channel containing names.
 * - Remove names containing only one character.
 * - Transform each name into a greeting.
 * - Execute SAVE_GREETINGS once per greeting.
 * - Expose the generated files as workflow output.
 */

workflow CREATE_GREETINGS {

    take:
    // Input channel containing names
    names

    main:
    // Keep only names containing more than one character
    filtered_names = names
        .filter { name -> name.size() > 1 }

    // Transform each name into a greeting
    greetings = filtered_names
        .map { name -> "Hello ${name}!" }
    greetings.view { "Greetings: $it" }

    // Collect all greetings into a single list
    all_greetings = greetings.collect()
    all_greetings.view { "All greetings: $it" }

    // Execute one process task per greeting
    SAVE_GREETINGS(greetings)

    // Execute one process task with the complete list
    COLLECT_GREETINGS(all_greetings)

    emit:
    // Expose the individual greeting files
    individual_files = SAVE_GREETINGS.out.result

    // Expose the file containing all greetings
    collected_file = COLLECT_GREETINGS.out.result
}


/*
 * ENTRY WORKFLOW
 *
 * - Read names from the input parameter.
 * - Create a channel with individual names.
 * - Execute the named workflow.
 * - Publish the generated files.
 */

workflow {

    main:
    // Create a channel from the input parameter
    println "Input string: ${params.input}"
    input_ch = channel.of(params.input).view { "Input string: $it" }
    println "Input string channel: ${input_ch}"

    // Split the comma-separated input and create a channel

    names_ch = channel.fromList(
        params.input.split(',').collect { it.trim() }
    )
    names_ch.view { "Input name: $it" }

    // Execute the named workflow
    CREATE_GREETINGS(names_ch)

    publish:
    // Publish individual greeting files
    greeting_files = CREATE_GREETINGS.out.individual_files

    // Publish the file containing all greetings
    all_greetings_file = CREATE_GREETINGS.out.collected_file
}


/*
 * WORKFLOW OUTPUTS
 *
 * - Define where the published results will be stored.
 * - Copy the generated files into the output directory.
 */

output {
    greeting_files {
        path 'individual_greetings'
        mode 'copy'
    }

    all_greetings_file {
        path 'all_greetings'
        mode 'copy'
    }
}